<Project>
  <PropertyGroup>
    <!-- Keep the release identity in one place; CI can override VersionPrefix. -->
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.1.0</VersionPrefix>
    <Version Condition="'$(Version)' == ''">$(VersionPrefix)</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(VersionPrefix).0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(VersionPrefix).0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    <Authors Condition="'$(Authors)' == ''">Timenotifier contributors</Authors>
    <RepositoryType Condition="'$(RepositoryType)' == ''">git</RepositoryType>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/fuyao606/workbox</RepositoryUrl>
    <PackageLicenseExpression Condition="'$(PackageLicenseExpression)' == ''">MIT</PackageLicenseExpression>
    <Copyright Condition="'$(Copyright)' == ''">Copyright (c) 2026 Timenotifier contributors</Copyright>
  </PropertyGroup>
</Project>
