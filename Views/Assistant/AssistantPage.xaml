<UserControl x:Class="Timenotifier.Views.Assistant.AssistantPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             AutomationProperties.AutomationId="AssistantPage"
             FontFamily="{StaticResource TimenotifierFontFamily}"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="AssistantButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TimenotifierSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryAssistantButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TimenotifierPrimaryButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource TimenotifierCardStyle}"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="4,2,4,10">
                    <materialDesign:PackIcon Kind="Forum"
                                            Width="19"
                                            Height="19"
                                            Foreground="{StaticResource PrimaryBrush}"
                                            Margin="0,0,7,0" />
                    <TextBlock Text="对话"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="NewSessionButton"
                            AutomationProperties.AutomationId="NewSessionButton"
                            Content="新对话"
                            Style="{StaticResource PrimaryAssistantButtonStyle}"
                            Click="OnNewSessionClicked" />
                    <Button Grid.Column="2"
                            x:Name="DeleteSessionButton"
                            AutomationProperties.AutomationId="DeleteSessionButton"
                            Content="删除"
                            ToolTip="删除当前对话"
                            Style="{StaticResource AssistantButtonStyle}"
                            Click="OnDeleteSessionClicked" />
                </Grid>
                <ListBox Grid.Row="2"
                         x:Name="SessionList"
                         AutomationProperties.AutomationId="AssistantSessionList"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnSessionSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,7" MaxWidth="174">
                                <TextBlock Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                           FontSize="11"
                                           Foreground="{StaticResource FaintTextBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="3"
                           Text="会话仅加密保存在本机"
                           FontSize="11"
                           Foreground="{StaticResource FaintTextBrush}"
                           TextWrapping="Wrap"
                           Margin="4,8,4,2" />
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource TimenotifierCardStyle}"
                    Padding="12,8"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="工作范围"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1"
                              x:Name="ModuleCombo"
                              AutomationProperties.AutomationId="AssistantModuleCombo"
                              DisplayMemberPath="Name"
                              MinHeight="32"
                              VerticalContentAlignment="Center" />
                    <Button Grid.Column="3"
                            AutomationProperties.AutomationId="OpenAssistantModuleButton"
                            Content="打开详情"
                            Style="{StaticResource AssistantButtonStyle}"
                            Click="OnOpenModuleClicked" />
                    <TextBlock Grid.Column="4"
                               x:Name="RequestStateText"
                               AutomationProperties.AutomationId="AssistantRequestState"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Text="就绪" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource SubtleSurfaceBrush}"
                    BorderBrush="{StaticResource SoftBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <ScrollViewer x:Name="MessagesScrollViewer"
                              AutomationProperties.AutomationId="AssistantMessagesScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16">
                    <StackPanel x:Name="MessagesPanel" />
                </ScrollViewer>
            </Border>

            <Border Grid.Row="2"
                    x:Name="AttachmentPanel"
                    Style="{StaticResource TimenotifierCardStyle}"
                    Padding="8"
                    Margin="0,8,0,0"
                    Visibility="Collapsed">
                <ItemsControl x:Name="AttachmentItems"
                              AutomationProperties.AutomationId="AssistantAttachmentList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SubtleSurfaceBrush}"
                                    BorderBrush="{StaticResource SoftBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="8,4"
                                    Margin="0,0,6,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Metadata.Name}"
                                               MaxWidth="190"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Button Content="×"
                                            ToolTip="移除附件"
                                            Margin="6,0,0,0"
                                            Padding="3,0"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Click="OnRemoveAttachmentClicked" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Grid.Row="3"
                    x:Name="PendingActionCard"
                    AutomationProperties.AutomationId="AssistantPendingActionCard"
                    Background="{StaticResource WarningSurfaceBrush}"
                    BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,8,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="需要确认"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}" />
                        <TextBlock x:Name="PendingActionSummary"
                                   AutomationProperties.AutomationId="AssistantPendingActionSummary"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,12,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            x:Name="ConfirmActionButton"
                            AutomationProperties.AutomationId="ConfirmAssistantActionButton"
                            Content="确认执行"
                            Style="{StaticResource PrimaryAssistantButtonStyle}"
                            Click="OnConfirmActionClicked" />
                    <Button Grid.Column="3"
                            x:Name="DeclineActionButton"
                            AutomationProperties.AutomationId="DeclineAssistantActionButton"
                            Content="拒绝"
                            Style="{StaticResource AssistantButtonStyle}"
                            Click="OnDeclineActionClicked" />
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Style="{StaticResource TimenotifierCardStyle}"
                    Padding="10"
                    Margin="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="ComposerTextBox"
                             AutomationProperties.AutomationId="AssistantComposerTextBox"
                             MinHeight="54"
                             MaxHeight="100"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             PreviewKeyDown="OnComposerPreviewKeyDown" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AddAttachmentButton"
                                AutomationProperties.AutomationId="AddAssistantAttachmentButton"
                                Content="添加附件"
                                Style="{StaticResource AssistantButtonStyle}"
                                Click="OnAddAttachmentClicked" />
                        <Button Grid.Column="2"
                                x:Name="CancelButton"
                                AutomationProperties.AutomationId="CancelAssistantRequestButton"
                                Content="取消"
                                Style="{StaticResource AssistantButtonStyle}"
                                Visibility="Collapsed"
                                Click="OnCancelClicked" />
                        <Button Grid.Column="4"
                                x:Name="SendButton"
                                AutomationProperties.AutomationId="SendAssistantMessageButton"
                                Content="发送"
                                Style="{StaticResource PrimaryAssistantButtonStyle}"
                                Click="OnSendClicked" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
