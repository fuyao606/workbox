<Window x:Class="Timenotifier.Views.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Timenotifier.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Timenotifier 配置中心"
        Width="1180"
        Height="760"
        MinWidth="1050"
        MinHeight="640"
        Icon="/Assets/Timenotifier.ico"
        FontFamily="Microsoft YaHei UI"
        Style="{StaticResource TimenotifierWindowStyle}"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <views:NonBlankStringToVisibilityConverter x:Key="NonBlankStringToVisibilityConverter" />

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TimenotifierPrimaryButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource PrimaryPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TimenotifierSecondaryButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource TintSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TimenotifierDangerButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#FFF0F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#F9E2E2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource TimenotifierFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushModern}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource TimenotifierFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushModern}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="InputChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConfigurationSectionsStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TabStripPlacement" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              KeyboardNavigation.TabIndex="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavigationItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavigationSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,16,0,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FaintTextBrush}" />
        </Style>
        <Style x:Key="ToolbarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TimenotifierSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ToolMenuButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TimenotifierSecondaryButtonStyle}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource ShellContainerStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="4,0,4,16"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42"
                            Height="42"
                            CornerRadius="6"
                            Background="{StaticResource TintSurfaceBrush}"
                            Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="TuneVariant"
                                                Width="22"
                                                Height="22"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource PrimaryBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="配置中心"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock x:Name="CurrentSectionTitleText"
                                       Text="AI 助手"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Text="  ·  配置保存在本机，保存后即时生效"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="AssistantHomeButton"
                            AutomationProperties.AutomationId="ConfigurationAssistantHomeButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="返回 AI 助手"
                            Click="OnAssistantHomeClicked">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Forum"
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,7,0" />
                            <TextBlock Text="AI 助手" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ToolsMenuButton"
                            AutomationProperties.AutomationId="ConfigurationToolsButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="打开模块快捷菜单"
                            Click="OnToolsMenuClicked">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Apps"
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,7,0" />
                            <TextBlock Text="模块" />
                            <materialDesign:PackIcon Kind="ChevronDown"
                                                    Width="15"
                                                    Height="15"
                                                    VerticalAlignment="Center"
                                                    Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Popup x:Name="ToolsMenuPopup"
               AutomationProperties.AutomationId="ConfigurationToolsPopup"
               PlacementTarget="{Binding ElementName=ToolsMenuButton}"
               Placement="Bottom"
               HorizontalOffset="-246"
               VerticalOffset="8"
               AllowsTransparency="True"
               StaysOpen="False">
            <Border Width="246"
                    Padding="10"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SoftBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Effect="{StaticResource ShellShadow}">
                <StackPanel>
                    <TextBlock Text="配置工具"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="4,2,4,6" />
                    <Button Tag="Reminders" AutomationProperties.AutomationId="ConfigurationToolRemindersButton" Style="{StaticResource ToolMenuButtonStyle}" Click="OnToolMenuItemClicked">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Bell" Width="17" Height="17" Margin="0,0,9,0" /><TextBlock Text="提醒" /></StackPanel>
                    </Button>
                    <Button Tag="Model" AutomationProperties.AutomationId="ConfigurationToolModelButton" Style="{StaticResource ToolMenuButtonStyle}" Click="OnToolMenuItemClicked">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Brain" Width="17" Height="17" Margin="0,0,9,0" /><TextBlock Text="模型" /></StackPanel>
                    </Button>
                    <Button Tag="Evidence" AutomationProperties.AutomationId="ConfigurationToolEvidenceButton" Style="{StaticResource ToolMenuButtonStyle}" Click="OnToolMenuItemClicked">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FolderSearch" Width="17" Height="17" Margin="0,0,9,0" /><TextBlock Text="证据" /></StackPanel>
                    </Button>
                    <Button Tag="Review" AutomationProperties.AutomationId="ConfigurationToolReviewButton" Style="{StaticResource ToolMenuButtonStyle}" Click="OnToolMenuItemClicked">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="TimelineClockOutline" Width="17" Height="17" Margin="0,0,9,0" /><TextBlock Text="回顾" /></StackPanel>
                    </Button>
                    <Button Tag="Reports" AutomationProperties.AutomationId="ConfigurationToolReportsButton" Style="{StaticResource ToolMenuButtonStyle}" Click="OnToolMenuItemClicked">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="17" Height="17" Margin="0,0,9,0" /><TextBlock Text="报告" /></StackPanel>
                    </Button>
                    <Button Tag="Capture" AutomationProperties.AutomationId="ConfigurationToolCaptureButton" Style="{StaticResource ToolMenuButtonStyle}" Click="OnToolMenuItemClicked">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CameraOutline" Width="17" Height="17" Margin="0,0,9,0" /><TextBlock Text="采集" /></StackPanel>
                    </Button>
                    <Button Tag="Tasks" AutomationProperties.AutomationId="ConfigurationToolTasksButton" Style="{StaticResource ToolMenuButtonStyle}" Click="OnToolMenuItemClicked">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="17" Height="17" Margin="0,0,9,0" /><TextBlock Text="任务" /></StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="206" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="8"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SoftBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom"
                            Padding="10"
                            Margin="0,12,0,0"
                            Background="{StaticResource SubtleSurfaceBrush}"
                            CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="配置保存在本机" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="保存后立即生效" FontSize="11" Margin="0,3,0,0" Foreground="{StaticResource FaintTextBrush}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="工作台" Style="{StaticResource NavigationSectionLabelStyle}" />
                            <ListBox x:Name="NavigationList"
                                     AutomationProperties.AutomationId="ConfigurationNavigation"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemContainerStyle="{StaticResource NavigationItemStyle}"
                                     SelectionChanged="OnNavigationSelectionChanged">
                                <ListBoxItem Tag="Assistant"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ForumOutline" Width="18" Height="18" Margin="0,0,10,0" /><TextBlock Text="AI 助手" /></StackPanel></ListBoxItem>
                                <ListBoxItem Tag="Reminders"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="BellOutline" Width="18" Height="18" Margin="0,0,10,0" /><TextBlock Text="提醒" /></StackPanel></ListBoxItem>
                                <ListBoxItem Tag="Evidence"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FolderSearchOutline" Width="18" Height="18" Margin="0,0,10,0" /><TextBlock Text="证据管理" /></StackPanel></ListBoxItem>
                                <ListBoxItem Tag="Review"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="TimelineClockOutline" Width="18" Height="18" Margin="0,0,10,0" /><TextBlock Text="时间回顾" /></StackPanel></ListBoxItem>
                            </ListBox>
                            <TextBlock Text="系统与产出" Style="{StaticResource NavigationSectionLabelStyle}" />
                            <ListBox x:Name="SystemNavigationList"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemContainerStyle="{StaticResource NavigationItemStyle}"
                                     SelectionChanged="OnNavigationSelectionChanged">
                                <ListBoxItem Tag="Reports"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="18" Height="18" Margin="0,0,10,0" /><TextBlock Text="报告" /></StackPanel></ListBoxItem>
                                <ListBoxItem Tag="Model"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Brain" Width="18" Height="18" Margin="0,0,10,0" /><TextBlock Text="模型服务" /></StackPanel></ListBoxItem>
                                <ListBoxItem Tag="Capture"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CameraOutline" Width="18" Height="18" Margin="0,0,10,0" /><TextBlock Text="采集与隐私" /></StackPanel></ListBoxItem>
                                <ListBoxItem Tag="Tasks"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="18" Height="18" Margin="0,0,10,0" /><TextBlock Text="自动化任务" /></StackPanel></ListBoxItem>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <TabControl x:Name="Sections"
                        AutomationProperties.AutomationId="Sections"
                        Style="{StaticResource ConfigurationSectionsStyle}"
                        Grid.Column="2">
            <TabItem Header="AI 助手"
                     AutomationProperties.AutomationId="TabAssistant">
                <ContentControl x:Name="AssistantHost"
                                Margin="0,14,0,0" />
            </TabItem>

            <TabItem Header="提醒"
                     AutomationProperties.AutomationId="TabReminders">
                <ScrollViewer x:Name="ReminderScrollViewer"
                              AutomationProperties.AutomationId="ConfigurationReminderScrollViewer"
                              views:SmoothScrollBehavior.IsEnabled="True"
                              Margin="0"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto">
                <Grid HorizontalAlignment="Stretch"
                      MinWidth="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource ReminderPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="提醒规则"
                                               Style="{StaticResource ReminderTitleStyle}" />
                                    <TextBlock Text="配置每天、工作日、指定星期或单次提醒，保存后立即生效。"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource ReminderHintStyle}" />
                                </StackPanel>
                                <WrapPanel HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           ItemHeight="38"
                                           Margin="0,12,0,0">
                                    <Button Content="新增提醒"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,0,8,6"
                                            Click="OnAddReminderClicked" />
                                    <Button Content="删除提醒"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Margin="0,0,12,6"
                                            Click="OnDeleteReminderClicked" />
                                    <TextBlock Text="稍后"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"
                                               Style="{StaticResource ReminderHintStyle}" />
                                    <TextBox x:Name="SnoozeMinutesBox"
                                             Width="72"
                                             Margin="0,0,6,6"
                                             Text="10"
                                             Style="{StaticResource ReminderCompactTextBoxStyle}" />
                                    <TextBlock Text="分钟"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,6"
                                               Style="{StaticResource ReminderHintStyle}" />
                                    <Button Content="保存提醒配置"
                                            Width="126"
                                            Margin="0,0,0,6"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="OnSaveRemindersClicked" />
                                </WrapPanel>
                            </StackPanel>

                        <DataGrid x:Name="ReminderGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding Reminders}"
                                      Style="{StaticResource ReminderDataGridStyle}">
                                <DataGrid.Columns>
                            <DataGridTemplateColumn Header="启用"
                                                            Width="68">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource GridCheckBoxStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="时间"
                                                        Binding="{Binding TimeText}"
                                                        Width="82" />
                                    <DataGridTextColumn Header="内容"
                                                        Binding="{Binding Message}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="规则"
                                                        Binding="{Binding ScheduleKindDisplay}"
                                                        IsReadOnly="True"
                                                        Width="92" />
                                    <DataGridComboBoxColumn x:Name="ScheduleKindColumn"
                                                            Header="规则值"
                                                            SelectedItemBinding="{Binding ScheduleKind}"
                                                            Width="118" />
                                    <DataGridTextColumn Header="指定星期"
                                                        Binding="{Binding WeekdaysText}"
                                                        Width="118" />
                                    <DataGridTextColumn Header="单次日期"
                                                        Binding="{Binding OnceDateText}"
                                                        Width="108" />
                                    <DataGridTextColumn Header="提前分钟"
                                                        Binding="{Binding AdvanceMinutes}"
                                                        Width="96" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Style="{StaticResource ReminderPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="节假日 / 调休规则"
                                               Style="{StaticResource ReminderTitleStyle}" />
                                    <TextBlock Text="节假日会跳过工作日提醒；调休上班会让周末按工作日提醒。"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource ReminderHintStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            DockPanel.Dock="Right">
                                    <Button Content="新增日期"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,10,0"
                                            Click="OnAddHolidayClicked" />
                                    <Button Content="删除日期"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Click="OnDeleteHolidayClicked" />
                                </StackPanel>
                            </DockPanel>
                            <DataGrid x:Name="HolidayGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding HolidayAdjustments}"
                                      Style="{StaticResource ReminderDataGridStyle}"
                                      RowHeight="40">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="日期"
                                                        Binding="{Binding DateText}"
                                                        Width="150" />
                                    <DataGridTextColumn Header="类型"
                                                        Binding="{Binding KindDisplay}"
                                                        IsReadOnly="True"
                                                        Width="120" />
                                    <DataGridComboBoxColumn x:Name="HolidayKindColumn"
                                                            Header="类型值"
                                                            SelectedItemBinding="{Binding Kind}"
                                                            Width="140" />
                                    <DataGridTextColumn Header="名称"
                                                        Binding="{Binding Name}"
                                                        Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="模型"
                     AutomationProperties.AutomationId="TabModel">
                <ScrollViewer x:Name="ModelScrollViewer"
                              AutomationProperties.AutomationId="ConfigurationModelScrollViewer"
                              views:SmoothScrollBehavior.IsEnabled="True"
                              Margin="0"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Stretch"
                                MinWidth="0">
                        <Border Style="{StaticResource SurfacePanelStyle}"
                                Margin="0,0,0,12">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="模型能力"
                                               Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="配置 OpenAI 兼容接口，按低成本、平衡或高质量模式生成报告。"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            DockPanel.Dock="Right">
                                    <TextBlock Text="能力模式"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="QualityModeBox"
                                              Width="150" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SurfacePanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="文本与视觉分析"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock Grid.Row="1"
                                               Text="用于日报、周报生成和截图视觉分析。"
                                               Margin="0,4,0,14"
                                               Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Grid.Row="2"
                                               Text="API 请求地址"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="TextBaseUrlBox"
                                             Grid.Row="3"
                                             Margin="0,6,0,12" />
                                    <TextBlock Grid.Row="4"
                                               Text="API Key"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <PasswordBox x:Name="TextApiKeyBox"
                                                 Grid.Row="5"
                                                 Margin="0,6,0,12" />
                                    <StackPanel Grid.Row="6">
                                        <TextBlock Text="模型"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="TextModelBox"
                                                 Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource SurfacePanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="图片生成接口"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock Grid.Row="1"
                                               Text="保留图片生成配置；报告生成仍以文本和视觉分析链路为主。"
                                               Margin="0,4,0,14"
                                               Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Grid.Row="2"
                                               Text="API 请求地址"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="VisionBaseUrlBox"
                                             Grid.Row="3"
                                             Margin="0,6,0,12" />
                                    <TextBlock Grid.Row="4"
                                               Text="API Key"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <PasswordBox x:Name="VisionApiKeyBox"
                                                 Grid.Row="5"
                                                 Margin="0,6,0,12" />
                                    <StackPanel Grid.Row="6">
                                        <TextBlock Text="模型"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="VisionModelBox"
                                                 Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource ActionBarStyle}">
                            <DockPanel>
                                <CheckBox x:Name="UseVisionBox"
                                          Content="启用截图多模态分析"
                                          VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            DockPanel.Dock="Right">
                                    <Button Content="测试 Analysis"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,10,0"
                                            Click="OnTestAnalysisClicked" />
                                    <Button Content="测试 ImageGeneration"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,10,0"
                                            Click="OnTestImageGenerationClicked" />
                                    <Button Content="保存模型配置"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="OnSaveModelClicked" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="证据"
                     AutomationProperties.AutomationId="TabEvidence">
                <ScrollViewer x:Name="EvidenceScrollViewer"
                              AutomationProperties.AutomationId="ConfigurationEvidenceScrollViewer"
                              views:SmoothScrollBehavior.IsEnabled="True"
                              Margin="0"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource SurfacePanelStyle}"
                        HorizontalAlignment="Stretch"
                        MinWidth="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="证据管理"
                                           Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="管理今日或本周证据，勾选“纳入”的内容会进入报告生成。"
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                            <Border Style="{StaticResource ActionBarStyle}"
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="EvidenceRangeBox"
                                              Width="92"
                                              SelectedIndex="0"
                                              Margin="0,0,8,0">
                                        <ComboBoxItem Content="今日" />
                                        <ComboBoxItem Content="本周" />
                                    </ComboBox>
                                    <Button Content="获取证据"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="OnRefreshEvidenceClicked" />
                                    <Button Content="批量删除"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Margin="8,0,0,0"
                                            Click="OnDeleteEvidenceClicked" />
                                </StackPanel>
                            </Border>
                        </DockPanel>
                        <DataGrid x:Name="EvidenceGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding Evidence}"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  KeyDown="OnEvidenceGridKeyDown"
                                  Style="{StaticResource ReminderDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="纳入"
                                                    Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Included, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Click="OnEvidenceIncludedClicked" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="时间"
                                                Binding="{Binding DisplayTime}"
                                                IsReadOnly="True"
                                                Width="120" />
                            <DataGridTextColumn Header="类型"
                                                Binding="{Binding DisplayKind}"
                                                IsReadOnly="True"
                                                Width="80" />
                            <DataGridTextColumn Header="标签"
                                                Binding="{Binding DisplayTags}"
                                                Width="110" />
                            <DataGridTextColumn Header="标题"
                                                Binding="{Binding Title}"
                                                ElementStyle="{StaticResource GridEllipsisTextStyle}"
                                                Width="180" />
                            <DataGridTextColumn Header="摘要"
                                                Binding="{Binding Summary}"
                                                ElementStyle="{StaticResource GridEllipsisTextStyle}"
                                                Width="*" />
                            <DataGridTemplateColumn Header="预览"
                                                    Width="80"
                                                    IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="预览"
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource PreviewButtonStyle}"
                                                Visibility="{Binding CanPreviewImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Click="OnPreviewEvidenceImageClicked" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="回顾"
                     AutomationProperties.AutomationId="TabReview">
                <ScrollViewer x:Name="ReviewScrollViewer"
                              AutomationProperties.AutomationId="ConfigurationReviewScrollViewer"
                              views:SmoothScrollBehavior.IsEnabled="True"
                              Margin="0"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Stretch"
                                MinWidth="0">
                        <Border Style="{StaticResource SurfacePanelStyle}"
                                Margin="0,0,0,12">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="工作时间线 / 今日回顾"
                                               Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="按时间确认截图、手动记录、活动窗口和 OCR 内容。刷新只读取已保存证据，不重新采集。"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <Border Style="{StaticResource ActionBarStyle}"
                                        DockPanel.Dock="Right"
                                        HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="TimelineRangeBox"
                                                  Width="92"
                                                  SelectedIndex="0"
                                                  Margin="0,0,8,0"
                                                  SelectionChanged="OnTimelineRangeChanged">
                                            <ComboBoxItem Content="今日" />
                                            <ComboBoxItem Content="本周" />
                                        </ComboBox>
                                        <Button Content="刷新回顾"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Margin="0,0,8,0"
                                                Click="OnRefreshTimelineClicked" />
                                        <Button Content="打开证据管理"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="OnOpenEvidenceManagementClicked" />
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>

                        <UniformGrid Columns="6"
                                     Margin="0,0,0,12">
                            <Border Style="{StaticResource TimelineStatCardStyle}"
                                    Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="总证据"
                                               Style="{StaticResource ReminderHintStyle}" />
                                    <TextBlock x:Name="TimelineTotalText"
                                               Text="0"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource PageTitleStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TimelineStatCardStyle}"
                                    Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="已纳入"
                                               Style="{StaticResource ReminderHintStyle}" />
                                    <TextBlock x:Name="TimelineIncludedText"
                                               Text="0"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource PageTitleStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TimelineStatCardStyle}"
                                    Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="截图"
                                               Style="{StaticResource ReminderHintStyle}" />
                                    <TextBlock x:Name="TimelineScreenshotText"
                                               Text="0"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource PageTitleStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TimelineStatCardStyle}"
                                    Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="手动记录"
                                               Style="{StaticResource ReminderHintStyle}" />
                                    <TextBlock x:Name="TimelineManualText"
                                               Text="0"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource PageTitleStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TimelineStatCardStyle}"
                                    Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="OCR"
                                               Style="{StaticResource ReminderHintStyle}" />
                                    <TextBlock x:Name="TimelineOcrText"
                                               Text="0"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource PageTitleStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TimelineStatCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="窗口"
                                               Style="{StaticResource ReminderHintStyle}" />
                                    <TextBlock x:Name="TimelineWindowText"
                                               Text="0"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource PageTitleStyle}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource SurfacePanelStyle}">
                            <ItemsControl ItemsSource="{Binding TimelineGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <DockPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Header}"
                                                           Style="{StaticResource SectionHeaderStyle}" />
                                                <TextBlock Text="{Binding CountText}"
                                                           DockPanel.Dock="Right"
                                                           HorizontalAlignment="Right"
                                                           Style="{StaticResource ReminderHintStyle}" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border>
                                                            <Border.Style>
                                                                <Style TargetType="Border"
                                                                       BasedOn="{StaticResource TimelineItemCardStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}"
                                                                                     Value="ManualNote">
                                                                            <Setter Property="Background"
                                                                                    Value="#FFFDF5" />
                                                                            <Setter Property="BorderBrush"
                                                                                    Value="#E8C76F" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}"
                                                                                     Value="Screenshot">
                                                                            <Setter Property="Background"
                                                                                    Value="#FBFEFF" />
                                                                            <Setter Property="BorderBrush"
                                                                                    Value="#7FB7D9" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}"
                                                                                     Value="CodexSession">
                                                                            <Setter Property="Background"
                                                                                    Value="#FCFBFF" />
                                                                            <Setter Property="BorderBrush"
                                                                                    Value="#A8A0D8" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}"
                                                                                     Value="TraeCnSession">
                                                                            <Setter Property="Background"
                                                                                    Value="#F8FEFB" />
                                                                            <Setter Property="BorderBrush"
                                                                                    Value="#76C7A5" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="70" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="128" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding DisplayTimelineTime}"
                                                                               FontSize="20"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#0F5F4B" />
                                                                    <Border Style="{StaticResource TimelineBadgeStyle}"
                                                                            Margin="0,8,0,0"
                                                                            HorizontalAlignment="Left">
                                                                        <TextBlock Text="{Binding DisplayKind}"
                                                                                   FontSize="12"
                                                                                   Foreground="#176B55" />
                                                                    </Border>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="1"
                                                                            Margin="10,0,12,0">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#142033"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding DisplayWindowInfo}"
                                                                               Visibility="{Binding DisplayWindowInfo, Converter={StaticResource NonBlankStringToVisibilityConverter}}"
                                                                               Margin="0,4,0,0"
                                                                               Style="{StaticResource MutedTextStyle}" />
                                                                    <TextBlock Text="{Binding DisplayTags}"
                                                                               Visibility="{Binding DisplayTags, Converter={StaticResource NonBlankStringToVisibilityConverter}}"
                                                                               Margin="0,4,0,0"
                                                                               Foreground="#176B55"
                                                                               FontSize="12" />
                                                                    <StackPanel Margin="0,9,0,0">
                                                                        <DockPanel Visibility="{Binding SummaryDetails.Source, Converter={StaticResource NonBlankStringToVisibilityConverter}}">
                                                                            <TextBlock Text="来源"
                                                                                       Width="54"
                                                                                       Foreground="#667085"
                                                                                       FontSize="12" />
                                                                            <TextBlock Text="{Binding SummaryDetails.Source}"
                                                                                       TextWrapping="Wrap"
                                                                                       Foreground="#344054"
                                                                                       FontSize="12" />
                                                                        </DockPanel>
                                                                        <DockPanel Visibility="{Binding SummaryDetails.WorkingDirectory, Converter={StaticResource NonBlankStringToVisibilityConverter}}"
                                                                                   Margin="0,4,0,0">
                                                                            <TextBlock Text="工作目录"
                                                                                       Width="54"
                                                                                       Foreground="#667085"
                                                                                       FontSize="12" />
                                                                            <TextBlock Text="{Binding SummaryDetails.WorkingDirectory}"
                                                                                       TextWrapping="Wrap"
                                                                                       Foreground="#475467"
                                                                                       FontFamily="Cascadia Mono, Consolas"
                                                                                       FontSize="11.5" />
                                                                        </DockPanel>
                                                                        <ItemsControl ItemsSource="{Binding SummaryDetails.Sections}"
                                                                                      Margin="0,7,0,0">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <StackPanel Margin="0,0,0,7">
                                                                                        <TextBlock Text="{Binding Title}"
                                                                                                   FontSize="12"
                                                                                                   FontWeight="SemiBold"
                                                                                                   Foreground="#175C4A"
                                                                                                   Margin="0,0,0,3" />
                                                                                        <ItemsControl ItemsSource="{Binding Items}">
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                    <Grid Margin="0,1,0,2">
                                                                                                        <Grid.ColumnDefinitions>
                                                                                                            <ColumnDefinition Width="15" />
                                                                                                            <ColumnDefinition Width="*" />
                                                                                                        </Grid.ColumnDefinitions>
                                                                                                        <TextBlock Text="•"
                                                                                                                   Foreground="#16866C"
                                                                                                                   FontSize="13" />
                                                                                                        <TextBlock Grid.Column="1"
                                                                                                                   Text="{Binding}"
                                                                                                                   TextWrapping="Wrap"
                                                                                                                   Foreground="#344054"
                                                                                                                   LineHeight="20" />
                                                                                                    </Grid>
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                    </StackPanel>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                    <Expander Header="OCR 内容"
                                                                              Visibility="{Binding OcrText, Converter={StaticResource NonBlankStringToVisibilityConverter}}"
                                                                              Margin="0,8,0,0"
                                                                              Foreground="#243044">
                                                                        <TextBox Text="{Binding OcrText, Mode=OneWay}"
                                                                                 IsReadOnly="True"
                                                                                 AcceptsReturn="True"
                                                                                 TextWrapping="Wrap"
                                                                                 MaxHeight="120"
                                                                                 VerticalScrollBarVisibility="Auto" />
                                                                    </Expander>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2"
                                                                            HorizontalAlignment="Right">
                                                                    <CheckBox Content="纳入报告"
                                                                              IsChecked="{Binding Included, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              Click="OnTimelineIncludedClicked" />
                                                                    <Button Content="预览截图"
                                                                            Margin="0,10,0,0"
                                                                            Style="{StaticResource PreviewButtonStyle}"
                                                                            Visibility="{Binding CanPreviewImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                            Click="OnPreviewEvidenceImageClicked" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="报告"
                     AutomationProperties.AutomationId="TabReport">
                <ScrollViewer x:Name="ReportScrollViewer"
                              AutomationProperties.AutomationId="ConfigurationReportScrollViewer"
                              views:SmoothScrollBehavior.IsEnabled="True"
                              Margin="0"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Stretch"
                            MinWidth="0">
                    <Border Style="{StaticResource SurfacePanelStyle}"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="报告素材"
                                               Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="先取证据，再查看聚类，最后载入历史草稿。"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            DockPanel.Dock="Right"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom">
                                    <ComboBox x:Name="ReportTypeBox"
                                              Width="88"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="日报" />
                                        <ComboBoxItem Content="周报" />
                                    </ComboBox>
                                    <Button Content="获取证据"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Width="94"
                                            Margin="8,0,0,0"
                                            Click="OnRefreshReportEvidenceClicked" />
                                </StackPanel>
                            </DockPanel>
                            <DataGrid x:Name="ReportEvidenceGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding ReportEvidence}"
                                      Style="{StaticResource ReminderDataGridStyle}"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      RowHeight="34">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间"
                                                        Binding="{Binding DisplayTime}"
                                                        IsReadOnly="True"
                                                        Width="82" />
                                    <DataGridTextColumn Header="标签"
                                                        Binding="{Binding DisplayTags}"
                                                        Width="70" />
                                    <DataGridTextColumn Header="标题"
                                                        Binding="{Binding Title}"
                                                        ElementStyle="{StaticResource GridEllipsisTextStyle}"
                                                        Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2"
                                       Text="证据聚类"
                                       Margin="0,12,0,7"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <DataGrid x:Name="ReportClusterGrid"
                                      Grid.Row="3"
                                      ItemsSource="{Binding ReportClusters}"
                                      IsReadOnly="True"
                                      Style="{StaticResource ReminderDataGridStyle}"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      RowHeight="32">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="聚类"
                                                        Binding="{Binding Name}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="数量"
                                                        Binding="{Binding EvidenceIds.Count}"
                                                        Width="68" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel Grid.Row="4"
                                       Margin="0,12,0,7">
                                <TextBlock Text="历史草稿"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SectionHeaderStyle}" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            DockPanel.Dock="Right">
                                    <Button Content="载入"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,0"
                                            Click="OnLoadDraftClicked" />
                                    <Button Content="删除"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Margin="0,0,8,0"
                                            Click="OnDeleteDraftClicked" />
                                    <Button Content="另存"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="OnNewDraftFromConfirmedClicked" />
                                </StackPanel>
                            </DockPanel>
                            <DataGrid x:Name="ReportHistoryGrid"
                                      Grid.Row="5"
                                      ItemsSource="{Binding ReportDrafts}"
                                      IsReadOnly="True"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      KeyDown="OnReportHistoryGridKeyDown"
                                      Style="{StaticResource ReminderDataGridStyle}"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      RowHeight="32">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="类型"
                                                        Binding="{Binding DisplayType}"
                                                        Width="60" />
                                    <DataGridTextColumn Header="日期"
                                                        Binding="{Binding DisplayRange}"
                                                        Width="110" />
                                    <DataGridTextColumn Header="状态"
                                                        Binding="{Binding DisplayStatus}"
                                                        Width="70" />
                                    <DataGridTextColumn Header="更新"
                                                        Binding="{Binding DisplayUpdatedAt}"
                                                        Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SurfacePanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="360" />
                                <RowDefinition Height="190" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="报告编辑"
                                               Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="先选择模板生成正文，再用结构化区域补充周报细节。"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom">
                                    <Button Content="生成今日日报"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,0,8,6"
                                            Click="OnGenerateDailyClicked" />
                                    <Button Content="生成本周周报"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,6"
                                            Click="OnGenerateWeeklyClicked" />
                                    <Button Content="确认定稿"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,0,0,6"
                                            Click="OnConfirmDraftClicked" />
                                </WrapPanel>
                            </Grid>
                            <TextBox x:Name="ReportContentBox"
                                     Grid.Row="1"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                            <Grid Grid.Row="2"
                                  Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="本周完成工作"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="WorkSummaryBox"
                                         Grid.Row="1"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                                <TextBlock Grid.Column="2"
                                           Text="存在问题"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="ProblemsBox"
                                         Grid.Row="1"
                                         Grid.Column="2"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                                <TextBlock Grid.Row="2"
                                           Margin="0,8,0,0"
                                           Text="下周计划"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="NextWeekPlanBox"
                                         Grid.Row="3"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="2"
                                           Margin="0,8,0,0"
                                           Text="所需支持/建议"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="SupportSuggestionsBox"
                                         Grid.Row="3"
                                         Grid.Column="2"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </Grid>
                            <Grid Grid.Row="3"
                                  Margin="0,12,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="报告操作"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SectionHeaderStyle}" />
                                <WrapPanel Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           ItemHeight="42">
                                    <Button Content="导出企业周报 Excel"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,6"
                                            Click="OnExportEnterpriseWeeklyExcelClicked" />
                                    <Button Content="导出学校周报 Excel"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,6"
                                            Click="OnExportSchoolWeeklyExcelClicked" />
                                    <Button Content="复制 Markdown"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,6"
                                            Click="OnCopyMarkdownClicked" />
                                    <Button Content="复制纯文本"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,6"
                                            Click="OnCopyPlainTextClicked" />
                                    <Button Content="保存草稿"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,0,6"
                                            Click="OnSaveDraftClicked" />
                                </WrapPanel>
                            </Grid>
                            <ComboBox x:Name="ReportTemplateBox"
                                      Visibility="Collapsed" />
                            <DataGrid x:Name="ReportTemplateGrid"
                                      Visibility="Collapsed"
                                      ItemsSource="{Binding ReportTemplates}"
                                      Style="{StaticResource ReminderDataGridStyle}"
                                      RowHeight="34">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="名称"
                                                        Binding="{Binding Name}"
                                                        Width="90" />
                                    <DataGridComboBoxColumn x:Name="TemplateScopeColumn"
                                                            Header="范围"
                                                            SelectedItemBinding="{Binding ReportTypeScope}"
                                                            Width="80" />
                                    <DataGridTextColumn Header="提示词要求"
                                                        Binding="{Binding PromptInstructions}"
                                                        Width="*" />
                                    <DataGridCheckBoxColumn Header="内置"
                                                            Binding="{Binding IsBuiltIn}"
                                                            IsReadOnly="True"
                                                            Width="58" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="采集"
                     AutomationProperties.AutomationId="TabCapture">
                <ScrollViewer x:Name="CaptureScrollViewer"
                              AutomationProperties.AutomationId="ConfigurationCaptureScrollViewer"
                              views:SmoothScrollBehavior.IsEnabled="True"
                              Margin="0"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Stretch"
                                MinWidth="0">
                        <Border Style="{StaticResource SurfacePanelStyle}"
                                Margin="0,0,0,12">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="证据采集"
                                               Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="控制自动截图、手动记录、OCR 和隐私过滤。"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            DockPanel.Dock="Right"
                                            HorizontalAlignment="Right">
                                    <CheckBox x:Name="AutoScreenshotEnabledBox"
                                              Content="启用自动截图"
                                              Margin="0,0,18,0" />
                                    <CheckBox x:Name="StartWithWindowsBox"
                                              Content="开机自启动"
                                              Margin="0,0,18,0" />
                                    <CheckBox x:Name="OcrEnabledBox"
                                              Content="启用本地 OCR" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SurfacePanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="截图策略"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock Grid.Row="1"
                                               Text="自动截图会按间隔采集，并只保留变化画面。"
                                               Margin="0,4,0,14"
                                               Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Grid.Row="2"
                                               Text="截图间隔（分钟）"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="ScreenshotIntervalBox"
                                             Grid.Row="3"
                                             Width="130"
                                             HorizontalAlignment="Left"
                                             Margin="0,6,0,12" />
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="最多保留自动截图"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="MaxAutoScreenshotsBox"
                                                     Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="手动记录快捷键"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="ManualHotkeyBox"
                                                     Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource SurfacePanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="保存与标签"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock Grid.Row="1"
                                               Text="截图、手动记录和报告证据会共用这些标签。"
                                               Margin="0,4,0,14"
                                               Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Grid.Row="2"
                                               Text="自动截图保存位置"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <DockPanel Grid.Row="3"
                                               Margin="0,6,0,12">
                                        <Button Content="选择目录"
                                                Width="96"
                                                DockPanel.Dock="Right"
                                                Margin="10,0,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="OnBrowseScreenshotDirectoryClicked" />
                                        <TextBox x:Name="ScreenshotDirectoryBox"
                                                 Style="{StaticResource ImportantPathTextBoxStyle}" />
                                    </DockPanel>
                                    <StackPanel Grid.Row="4">
                                        <TextBlock Text="默认标签（逗号分隔）"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="DefaultTagsBox"
                                                 Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource SurfacePanelStyle}">
                            <StackPanel>
                                <TextBlock Text="隐私过滤"
                                           Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="每行一个关键词，匹配窗口标题或进程名时跳过自动截图。"
                                           Margin="0,4,0,10"
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBox x:Name="PrivacyFiltersBox"
                                         Height="130"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                                <Button Content="保存采集设置"
                                        Width="126"
                                        HorizontalAlignment="Right"
                                        Margin="0,14,0,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="OnSaveCaptureSettingsClicked" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="任务"
                     AutomationProperties.AutomationId="TabTask">
                <ScrollViewer x:Name="TaskScrollViewer"
                              AutomationProperties.AutomationId="ConfigurationTaskScrollViewer"
                              views:SmoothScrollBehavior.IsEnabled="True"
                              Margin="0"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Stretch"
                                MinWidth="0">
                        <Border Style="{StaticResource SurfacePanelStyle}"
                                Margin="0,0,0,12">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="日报自动化任务"
                                               Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="每天定时生成日报草稿，填写到 PM 系统，提交前会等待你确认。"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            DockPanel.Dock="Right"
                                            HorizontalAlignment="Right">
                                    <Button Content="打开登录浏览器"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,10,0"
                                            Click="OnOpenDailyAutomationLoginBrowserClicked" />
                                    <Button Content="立即试运行"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,10,0"
                                            Click="OnRunDailyAutomationNowClicked" />
                                    <Button Content="保存任务配置"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="OnSaveDailyAutomationSettingsClicked" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SurfacePanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="执行设置"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                    <CheckBox x:Name="DailyAutomationEnabledBox"
                                              Grid.Row="1"
                                              Content="启用每日自动填报"
                                              Margin="0,10,0,14" />
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="执行时间"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="DailyAutomationRunTimeBox"
                                                     Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="日报页面 URL"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="DailyAutomationUrlBox"
                                                     Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="3"
                                               Text="首次使用请先打开登录浏览器完成 PM 系统登录。"
                                               Margin="0,14,0,0"
                                               Style="{StaticResource MutedTextStyle}" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource SurfacePanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="浏览器会话"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                    <Grid Grid.Row="1"
                                          Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="104" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Playwright 会话名"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="DailyAutomationSessionBox"
                                                     Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Edge 配置目录"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="DailyAutomationProfileBox"
                                                     Margin="0,6,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="3"
                                                Content="选择目录"
                                                Height="34"
                                                VerticalAlignment="Bottom"
                                                Margin="10,0,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="OnBrowseDailyAutomationProfileClicked" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource SurfacePanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="PM 表单默认值"
                                           Style="{StaticResource SectionHeaderStyle}" />
                                <Grid Grid.Row="1"
                                      Margin="0,14,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="参与项目名称"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="DailyAutomationProjectBox"
                                                 Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="工作量占比"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="DailyAutomationWorkloadBox"
                                                 Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="任务名称"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="DailyAutomationTaskBox"
                                                 Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="任务类型"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="DailyAutomationTypeBox"
                                                 Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Style="{StaticResource StatusBarPanelStyle}">
            <DockPanel>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="13" />
                <Button Content="关闭"
                        Width="92"
                        Height="34"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnCloseClicked" />
            </DockPanel>
        </Border>
    </Grid>
    </Border>
</Window>
