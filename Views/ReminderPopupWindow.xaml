<Window x:Class="Timenotifier.Views.ReminderPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="318"
        Height="112"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{StaticResource TimenotifierFontFamily}"
        MouseLeftButtonUp="OnPopupMouseLeftButtonUp">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource PrimaryBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="3"
                              Direction="270"
                              Color="#273A35"
                              Opacity="0.18" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="34"
                    Height="34"
                    CornerRadius="17"
                    Background="{StaticResource WarningSurfaceBrush}"
                    BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left">
                <materialDesign:PackIcon Kind="Bell"
                                        Width="19"
                                        Height="19"
                                        Foreground="{StaticResource WarningBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
            </Border>

            <Grid Grid.Column="1"
                  VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TitleText"
                           Text="时间提醒"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock x:Name="MessageText"
                           Grid.Row="1"
                           Margin="0,7,0,0"
                           TextWrapping="Wrap"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           LineHeight="23" />
            </Grid>
        </Grid>
    </Border>
</Window>
